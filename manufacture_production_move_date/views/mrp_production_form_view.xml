<?xml version='1.0' encoding='UTF-8' ?>
<odoo>

  <record id="mrp_production_form_view" model="ir.ui.view">
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view" />
    <field name="arch" type="xml">
        <xpath expr="//group[@name='group_extra_info']/field[@name='date_finished']" position="before">
          <field name="date_move" />
        </xpath>
        <xpath
                    expr="//field[@name='move_raw_ids']/tree[1]/field[@name='date_deadline']"
                    position="attributes"
                >
          <attribute name="column_invisible">False</attribute>
        </xpath>
        <xpath
                    expr="//field[@name='move_raw_ids']/tree[1]/field[@name='date']"
                    position="attributes"
                >
          <attribute name="column_invisible">False</attribute>
        </xpath>
    </field>
  </record>

</odoo>
