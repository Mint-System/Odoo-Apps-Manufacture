<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="view_mgmt_statement_wizard_form" model="ir.ui.view">
        <field name="name">mgmt.statement.wizard.form</field>
        <field name="model">mgmt.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Statement">
                <sheet>
                    <group name="nc_form">
                        <field name="parallel_workorder_id" readonly="1" />
                        <field name="parallel_production_id" readonly="1" />
                        <field
                            name="nonconformity_id"
                            domain="nonconformity_id_domain"
                        />
                        <field name="nc_number" />
                        <field name="description" />
                        <field name="component_id" domain="component_id_domain" />
                    </group>

                    <group string="Existing Nonconformity Statements">
                        <field name="statement_ids" nolabel="1">
                            <list>
                                <field name="name" />
                                <field name="nonconformity_id" />
                                <field name="component_id" />
                                <field name="create_date" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button
                        string="Confirm"
                        type="object"
                        name="action_create"
                        class="btn-primary"
                    />
                    <button
                        string="Confirm and New"
                        type="object"
                        name="action_create"
                        context="{'save_and_new': True}"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="mrp_production_parallel_management.action_mgmt_statement_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Register Statement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mgmt.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mgmt_statement_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
