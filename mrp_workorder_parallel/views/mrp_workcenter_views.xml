<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="mrp_workorder_parallel.mrp_workcenter_view" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.inherit.quick.finish</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_capacity']" position="after">
                <field name="enable_quick_finish"/>
            </xpath>
        </field>
    </record>
</odoo>