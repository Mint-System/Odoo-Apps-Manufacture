<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="mrp_workorder_view_form_tablet_inherit" model="ir.ui.view">
        <field name="name">mrp.workorder.view.form.tablet.components</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp_workorder.mrp_workorder_view_form_tablet"/>
        <field name="arch" type="xml">
            <!-- Add component lines to show BoM components and their selected lots -->
            <xpath expr="//div[@class='o_workorder_bar_center o_workorder_bar_content']" position="after">
                <div class="o_workorder_component_lines">
                    <label string="Components"/>
                    <field name="move_raw_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="product_id" string="Component"/>
                            <field name="product_uom_qty" string="Planned Qty"/>
                            <field name="quantity_done" string="Done Qty"/>
                            <field name="product_uom" string="Unit of Measure"/>
                            <field name="move_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="lot_id" domain="[('product_id', '=', parent.product_id)]" context="{'default_product_id': parent.product_id}"/>
                                    <field name="qty_done" string="Done Qty per Lot"/>
                                </tree>
                            </field>
                        </tree>
                    </field>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
