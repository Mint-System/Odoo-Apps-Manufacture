<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <record id="demo_endpoint_user" model="res.users">
            <field name="name">Demo Endpoint User</field>
            <field name="login">demo_endpoint_user</field>
            <field name="groups_id" eval="[(6, 0, [])]" />
      </record>
      <record id="demo_endpoint_group" model="res.groups">
            <field name="name">Demo Endpoint Group</field>
            <field name="users" eval="[(4, ref('demo_endpoint_user'))]"/>
            <field name="implied_ids" eval="[(4, ref('fastapi.group_fastapi_endpoint_runner'))]" />
      </record>
</odoo>