<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Production Repair">
                    <setting string="WIP Repair Location"
                             help="Internal location where units are held during repair">
                        <field name="repair_location_id"/>
                    </setting>
                    <setting string="Repair Workcenter"
                             help="Workcenter used for repair/rework work orders">
                        <field name="repair_workcenter_id"/>
                    </setting>
                    <setting string="Repair Loss"
                             help="Blocking loss for work orders on repair">
                        <field name="repair_loss_id"/>
                    </setting>
                    <setting string="Repair blocks Workorder"
                             help="Blocking behaviour of repairing units">
                        <field name="repair_blocks_wo"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>