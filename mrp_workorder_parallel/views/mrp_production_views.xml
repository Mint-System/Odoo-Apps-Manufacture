<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp_workorder_parallel.mrp_production_form_view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']" position="attributes">
                <attribute name="invisible">type == 'parallel'</attribute>
            </xpath>
            <xpath expr="//page[@name='operations']" position="after">
                <page
                    name="parallel_workorders"
                    string="Parallel Work Orders"
                    invisible="type != 'parallel'"
                >
                    <field
                        name="workorder_ids"
                        domain="[('type','=','parallel')]"
                        context="{'default_type':'parallel'}"
                    >
                        <list>
                            <field
                                name="type"
                                widget="badge"
                                invisible="type != 'parallel'"
                            />
                            <field name="name" />
                            <field name="id" />
                            <field name="workcenter_id" />
                            <field name="is_repair_wo" readonly="1" />
                            <field name="duration_expected" widget="float_time"/>
                            <field name="duration" widget="float_time" />
                            <field name="date_start" />
                            <field name="date_finished" />
                            <field name="state" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record
        id="view_mrp_production_filter"
        model="ir.ui.view"
    >
        <field name="name">mrp_workorder_parallel.view_mrp_production_filter</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='todo']" position="after">
                <filter
                    name="todo_non_sequential"
                    string="To-Do (no Sequential)"
                    domain="[('state', 'in', ('draft', 'confirmed', 'progress', 'to_close')), ('type', '!=', 'sequential')]"
                />
            </xpath>
        </field>
    </record>

</odoo>
