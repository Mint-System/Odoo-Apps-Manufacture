<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp_production_button_done.mrp_production_form_view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
             <xpath expr="//button[@name='button_mark_done'][1]" position="attributes">
                <attribute name="invisible">
                    not move_raw_ids or not show_produce or state != 'to_close'
                </attribute>
                <attribute name="string">
                    Close Prod.
                </attribute>
            </xpath>

            <xpath expr="//button[@name='button_mark_done'][2]" position="attributes">
                <attribute name="invisible">
                    not move_raw_ids or not show_produce_all or state != 'to_close'
                </attribute>
                <attribute name="string">
                    Close Prod.
                </attribute>
            </xpath>

            <xpath expr="//button[@name='button_mark_done'][3]" position="attributes">
                <attribute name="invisible">
                    move_raw_ids or not show_produce or state != 'to_close'
                </attribute>
                <attribute name="string">
                    Close Prod.
                </attribute>
            </xpath>

            <xpath expr="//button[@name='button_mark_done'][4]" position="attributes">
                <attribute name="invisible">
                    move_raw_ids or not show_produce_all or state != 'to_close'
                </attribute>
                <attribute name="string">
                    Close Prod.
                </attribute>
            </xpath>
            <xpath expr="//field[@name='show_produce_all']" position="after">
                <field name="show_produce_serial" invisible="1"/>
                <button name="button_generate_serials" invisible="not show_produce_serial"
                        string="Generate S/N" type="object" class="oe_highlight" data-hotkey="g"/>
            </xpath>

        </field>
    </record>
</odoo>
