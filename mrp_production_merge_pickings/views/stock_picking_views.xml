<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">mrp_production_merge_pickings.view_picking_form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='picking_type_id']" position="after">
                <field name="production_group_id" string="Group"/>
            </xpath>
        </field>
    </record>
</odoo>
