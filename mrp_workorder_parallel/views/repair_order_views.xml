<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="view_repair_order_form_inherit" model="ir.ui.view">
        <field name="name">repair_order.view_repair_order_form</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="workorder_id" invisible="not workorder_id" readonly="1" />
                <field name="production_id" invisible="not production_id" readonly="1" />
                <field name="parallel_production_id" invisible="not parallel_production_id" />
            </xpath>
        </field>
    </record>
</odoo>