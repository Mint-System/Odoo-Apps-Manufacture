<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    
   <t t-inherit="mrp_workorder.MrpDisplayRecord" t-inherit-mode="extension" owl="1">
   <xpath expr="//div[hasclass('card-title')]" position="before">
   
        <t t-if="saleId"><t t-esc="saleId"/> </t>
        
        <t t-else=""> <t>fehlt</t> </t>
        |
        <t t-if="partnerId"><t t-esc="partnerId"/> </t>
        
        <t t-else=""> <t>fehlt</t> </t>
        <hr/>
       
    </xpath>
    
    </t>
</templates>





