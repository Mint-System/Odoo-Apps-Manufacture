<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_production_form_parallel_maintenance" model="ir.ui.view">
        <field name="name">mrp.production.form.parallel.workorders.maintenance</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']" position="before">
                <page string="Maintenance">
                    <field name="maintenance_request_ids">
                        <list>
                            <field name="name"/>
                            <field name="maintenance_type"/>
                            <field name="request_date"/>
                            <field name="stage_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
