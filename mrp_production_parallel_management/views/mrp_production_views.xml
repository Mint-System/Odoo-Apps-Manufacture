<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_production_form_parallel_management" model="ir.ui.view">
        <field name="name">mrp.production.form.parallel.workorders.nonconformities</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']" position="before">
                <page string="Nonconformities">
                    <field name="statement_ids">
                        <list>
                            <field name="name"/>
                            <field name="workorder_id"/>
                            <field name="nonconformity_id"/>
                            <field name="component_id"/>
                            <field name="create_date"/>
                        </list>
                        <form>
                            <group>
                                <field name="name"/>
                                <field name="nonconformity_id"/>
                                <field name="component_id" domain="[('id', 'in', bom_component_ids)]"/>
                                <field name="description"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>