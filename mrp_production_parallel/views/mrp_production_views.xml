<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
         <field name="name">mrp_parallel_production.mrp_production_form_view</field>
         <field name="model">mrp.production</field>
         <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
         <field name="arch" type="xml">
             <xpath expr="//header" position="inside">
                  <field name="show_validate_button" invisible="1"/>
                  <field name="show_button_mark_done_parallel" invisible="1"/>
                  <!-- <button name="action_validate_all_sequential_pickings"
                        string="Validate Pickings"
                        type="object"
                        class="oe_highlight"
                        invisible="type != 'parallel' or not show_validate_button"/> -->
                   <button name="button_mark_done_parallel"
                        string="Close Par. Prod."
                        type="object"
                        class="oe_highlight"
                        invisible="type != 'parallel' or not show_button_mark_done_parallel"/>
             </xpath>

            <xpath expr="//div[field[@name='qty_producing']]" position="attributes">
                <attribute name="invisible">state == 'draft' or type == 'parallel'</attribute>
            </xpath>

            <xpath expr="//div//field[@name='product_qty']" position="attributes">
                <attribute name="invisible">state not in ('draft', 'done') or type == 'parallel'</attribute>
            </xpath>

            <xpath expr="//button[field[@name='product_qty']]" position="attributes">
                <attribute name="invisible">state in ('draft', 'done', 'cancel') or not id or type == 'parallel'</attribute>
            </xpath>

            <xpath expr="//label[@for='product_qty']" position="attributes">
                <attribute name="invisible">state != 'draft' and type == 'parallel'</attribute>
            </xpath>

            <xpath expr="//span[@class='fw-bold text-nowrap']" position="attributes">
                <attribute name="invisible">state != 'draft' and type == 'parallel'</attribute>
            </xpath>

            <xpath expr="(//button[@name='action_product_forecast_report'])[1]" position="attributes">
                <attribute name="invisible">state != 'draft' and type == 'parallel'</attribute>
            </xpath>  

            <xpath expr="(//button[@name='action_product_forecast_report'])[2]" position="attributes">
                <attribute name="invisible">state != 'draft' and type == 'parallel'</attribute>
            </xpath>  

            <xpath expr="(//field[@name='move_raw_ids']//list//field[@name='product_uom_qty'])[1]" position="attributes">
                <attribute name="column_invisible">(not parent.show_produce_all) or parent.type == 'parallel'</attribute>
            </xpath>

            <xpath expr="(//field[@name='move_raw_ids']//list//field[@name='product_uom_qty'])[2]" position="attributes">
                <attribute name="column_invisible">parent.show_produce_all or parent.type == 'parallel'</attribute>
            </xpath>

            <xpath expr="//field[@name='move_raw_ids']//list//field[@name='quantity']" position="attributes">
                <attribute name="column_invisible">parent.state == 'draft' or parent.type == 'parallel' </attribute>
            </xpath>

            <xpath expr="//field[@name='move_raw_ids']//list//field[@name='picked']" position="attributes">
                <attribute name="column_invisible">parent.state == 'draft' or parent.type == 'parallel' </attribute>
            </xpath>

            <xpath expr="//field[@name='move_raw_ids']//list//field[@name='lot_ids']" position="attributes">
                <attribute name="column_invisible">(not parent.show_lot_ids) or parent.state == 'draft' or parent.type == 'parallel' </attribute>
                <attribute name="invisible">(not show_details_visible) or parent.type == 'parallel' </attribute>
            </xpath>

             <xpath expr="//field[@name='move_raw_ids']" position="attributes">
                <attribute name="widget"></attribute>
            </xpath>

             <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_view_sequential_productions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list"
                        invisible="type != 'parallel'">
                    <field name="sequential_production_ids" widget="statinfo" string="Sequential"/>
                </button>
            </xpath>
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                 <button name="action_view_parallel_production"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-link"
                        invisible="type != 'sequential'">
                    <field name="parallel_production_id" widget="statinfo" string="Parallel"/>
                </button>
            </xpath>
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_view_sequential_pickings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="type != 'parallel'">
                    <field name="sequential_picking_ids" widget="statinfo" string="Seq. Pickings"/>
                </button>
            </xpath>
             <xpath expr="//group[@name='group_extra_info']" position="after">
                 <group name="group_parallel_production">
                     <field name="type" />
                 </group>
             </xpath>
             <xpath expr="//field[@name='name']" position="after">
                <div invisible="type != 'parallel'">
                    <span class="badge badge-primary"
                        style="margin-left:8px; background-color:#007bff; color:white; padding:2px 6px; border-radius:4px;">
                        P
                    </span>
                </div>
            </xpath>
            <xpath expr="//label[@for='lot_producing_id']" position="attributes">
                <attribute name="invisible">type == 'parallel' or state == 'draft' or product_tracking in ('none', False)</attribute>
            </xpath>

            <xpath expr="//div[@class='o_row'][field[@name='lot_producing_id']]" position="attributes">
                <attribute name="invisible">type == 'parallel' or state == 'draft' or product_tracking in ('none', False)</attribute>
            </xpath> 
            <xpath expr="//label[@name='bom_label']" position="before">
                <field name="parallel_total_units" invisible="type != 'parallel'" />
            </xpath>
            <xpath expr="//page[@name='components']" position="after">
                <page name="sequential_productions" string="Sequential Productions" invisible="type != 'parallel'">
                    <field name="sequential_production_ids" context="{'default_parallel_production_id': id}"
                       domain="[('type','=','sequential')]"
                       nolabel="1">
                        <list editable="bottom">
                            <!-- <field name="name" widget="many2one"/> -->
                            <field name="link_mo_id" string="Order"/>
                            <field name="product_id"/>
                            <field name="lot_producing_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
                <page string="Sequential Pickings" invisible="type != 'parallel'">
                    <field name="sequential_picking_ids" context="{'default_origin': name}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="state"/>
                            <field name="picking_type_id"/>
                            <field name="scheduled_date"/>
                            <field name="partner_id"/>
                        </list>
                    </field>
                </page>
                <page string="Post Calculation" invisible="type != 'parallel'">   
                    <field name="summary_id" context="{'form_view_ref':'my_module.view_mrp_parallel_summary_form'}"/>
                </page>
            </xpath>
            <xpath expr="//field[@name='show_produce_all']" position="after">
                <field name="type" invisible="1"/>
            </xpath> 
           <xpath expr="(//button[@name='button_mark_done'])[1]" position="attributes">
                <attribute name="invisible" add="type in ['sequential']" separator=" or "/>
            </xpath>  
           <xpath expr="(//button[@name='button_mark_done'])[2]" position="attributes">
                <attribute name="invisible" add="type in ['sequential']" separator=" or "/>
            </xpath>  
            <xpath expr="(//button[@name='button_mark_done'])[3]" position="attributes">
                <attribute name="invisible" add="type in ['sequential']" separator=" or "/>
            </xpath> 
            <xpath expr="(//button[@name='button_mark_done'])[4]" position="attributes">
                <attribute name="invisible" add="type in ['sequential']" separator=" or "/>
            </xpath> 
            <xpath expr="//button[@name='button_plan']" position="attributes">
                <attribute name="invisible" add="type in ['sequential']" separator=" or "/>
            </xpath> 
            <xpath expr="//button[@name='button_unplan']" position="attributes">
                <attribute name="invisible" add="type in ['sequential']" separator=" or "/>
            </xpath> 
         </field>
    </record>


    <record id="view_mrp_production_tree_inherit" model="ir.ui.view">
        <field name="name">mrp.production.tree.inherit.sequential</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <button name="action_view_sequential_productions"
                        type="object"
                        string="Sequential"
                        icon="fa-random"
                        invisible="type != 'parallel'"/>
            </xpath>
        </field>
    </record>

<record id="view_mrp_production_form_inherit_parallel" model="ir.ui.view">
    <field name="name">mrp.production.form.parallel.summary</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
            <button name="action_generate_parallel_summary"
                    type="object"
                    string="Summary"
                    class="btn-secondary"
                    invisible="state not in ('done')"/>
        </xpath>
    </field>
</record>


    

    

</odoo>