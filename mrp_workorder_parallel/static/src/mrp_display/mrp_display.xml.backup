<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
	<t t-inherit="mrp_workorder.MrpDisplayRecord" t-inherit-mode="extension">
	    <xpath expr="//ul[@class='list-group list-group-flush']" position="before">
	    	<t t-if="record.type == 'parallel'">
		        <ul class="list-group list-group-flush">
		            <t t-if="record.type == 'parallel' and record.sequential_infos.infos">
		                <div class="d-flex justify-content-between align-items-center px-3">
		                	<div class="ml-4 mr-4 mt-2">
		                    	<div class="mb-1">
			                        <b><span class="me-1 mb-1">
			                            <t t-esc="record.workorder_infos.workcenter"/>
			                        </span></b>
		                    	</div>
		                    	<div class="mb-1">
			                        <span class="me-1 mb-1">
			                            <t t-esc="record.name"/>
			                        </span>
			                        (<span class="me-1 mb-1">
			                            <t t-esc="record.id"/>
			                        </span>)
		                    	</div>
		                    	<t t-if="record.sequential_stats">
								  <div class="flex flex-row gap-2 mt-2">
								    <span class="badge bg-secondary"><t t-esc="record.sequential_infos.active_wo_count"/> / <t t-esc="record.sequential_stats.total_serials"/></span>
								   <!--  <span class="badge bg-success"><t t-esc="record.sequential_stats.done_serials"/></span>
								    <span class="badge bg-info"><t t-esc="record.sequential_stats.current_wo_serials"/></span> -->
								    <span class="badge bg-primary"><t t-esc="record.sequential_stats.registered_serials"/></span>
								  </div>
								</t>

		               		</div>
		                	<div>
			                    <!-- <t t-foreach="record.sequential_infos.infos" t-as="prod" t-key="prod.id">
			                    	<div class="mb-1">
				                        <span class="badge rounded-pill text-white me-1 mb-1"
				                              t-att-style="'background-color: ' + (
				                                  prod.state == 'progress' and '#007bff' or
				                                  prod.state == 'done' and '#28a745' or
				                                  '#6c757d'
				                              )">
				                            <t t-esc="prod.serial"/>
				                        </span>
			                    	</div>
			                    </t> -->
			                    <button type="button"
					                    class="btn btn-outline-primary btn-sm mt-2"
					                    t-on-click="onClickOpenSequentialModal">
					                Show Serials
					            </button>

		               		</div>
		                </div>
		            </t>
		        </ul>
		        <div t-if="props.record.resModel === 'mrp.workorder'">
			        <ul class="list-group list-group-flush">
			        	<div class="d-flex justify-content-between align-items-center px-3">
		                	<div class="ml-4 mr-4 mt-2">
		                    	<div class="mb-1">
		                    		<button type="button"
						                    class="btn btn-outline-warning btn-sm mt-2"
						                    t-on-click="onClickOpenStatementModal">
						                Fehler
						            </button>
						            <button type="button"
									        class="btn btn-info btn-sm mt-2"
									        t-on-click="onClickToggleMode"
									        t-esc="buttonText">
									</button>
		                    	</div>
		                    </div>
			            </div>
			        </ul>
		        </div>
		        <ul class="list-group list-group-flush">
		        	<t t-if="record.type == 'parallel'">
		                <div class="mt-2 mb-2 text-center d-flex justify-content-between mx-2">
		                	<t t-if="record.is_finished">
		                		<span>All done</span>
		                	</t>
		                	
	                    	<t t-if="record.has_ready">
	                    		<button class="btn btn-lg text-nowrap btn-secondary" t-on-click="onClickStartBatch" title="Start Batch">
									<span><i class="fa fa-play"/></span>
								</button>
							</t>
							<t t-if="record.has_paused">
								<button class="btn btn-lg text-nowrap btn-secondary" t-on-click="onClickContinueBatch" title="Continue Batch">
									<span><i class="fa fa-forward"/></span>
								</button>
							</t>
							<t t-if="record.has_running">
								<button class="btn btn-lg text-nowrap btn-secondary" t-on-click="onClickStopBatch" title="Stop Batch">
									<span><i class="fa fa-pause"/></span>
								</button>
							</t>
							<t t-if="!record.is_finished and record.has_running and record.has_registered_serial">
								<button class="btn btn-lg text-nowrap btn-secondary" t-on-click="onClickFinishBatch" title="Finish Batch">
									<span><i class="fa fa-stop"/></span>
								</button>
		                    </t>
		                    <t t-if="record.has_running and !record.is_finished and !record.has_registered_serial">
									<span>Please <i class="fa fa-barcode"/></span>
		                    </t>
		                    <t t-if="!record.is_finished and record.enable_quick_finish">
								<button class="btn btn-sm text-nowrap btn-secondary" t-on-click="onClickQuickFinishBatch" title="Quick Finish Batch">
									<span>Quick Finish</span>
								</button>
		                    </t>
			                
		                </div>
		            </t>
		        </ul>
		     </t>
		    <t t-else="">
		    	<span></span>
		    </t>
	    </xpath>
	</t>

	<t t-inherit="mrp_workorder.MrpDisplayWorkorderHeader" t-inherit-mode="extension">
		<xpath expr="//span[@class='h5 text-truncate']" position="replace">
			<t t-if="record.type == 'parallel'">
				<span class="h5 text-truncate" t-esc="record.workorder_infos.parent_production"/>
			</t>
			<t t-else="">
				<t t-name="mrp_workorder.MrpDisplayWorkorderHeader">
			        <span class="h5 text-truncate" t-esc="record.display_name"/>
			        <span class="text-capitalize d-flex flex-column ms-1">
			            <div t-if="this.props.record.data.employee_assigned_ids.records.length > 0" class="pt-1">
			                <t t-foreach="this.props.record.data.employee_assigned_ids.records" t-as="employee" t-key="employee.resId">
			                    <img t-attf-src="/web/image/hr.employee/{{employee.resId}}/avatar_128" class="rounded o_avatar_connected me-1"/>
			                </t>
			            </div>
			        </span>
			        <i class="fa" t-att-class="this.active ? 'fa-pause' : 'fa-play'"></i>
			    </t>
			</t>

		</xpath>
	</t>


	<t t-inherit="mrp_workorder.MrpDisplayProductionFooter" t-inherit-mode="extension">
		<xpath expr="//button" position="replace">
		   <!--  <button t-if="displayDoneButton" t-attf-class="btn #{_btn_type}"
	                t-on-click="onClickValidateButton" t-att-barcode_trigger="props.barcodeTarget ? 'CLMO' : false">
	            <t t-if="state.underValidation">Undo</t>
	            <t t-elif="trackingMode === 'mass_produce'">Mass Produce</t>
	            <t t-else="">Prepare Close Production</t>
	        </button> -->
	        <t t-if="record.type == 'parallel'">
	        	<span>Please close Production in backend.</span>
	        </t>
	        <t t-else="">
				<t t-if="state.underValidation" t-set="_btn_type" t-value="'btn-outline-secondary'"/>
		        <t t-elif="props.record.data.state === 'to_close'" t-set="_btn_type" t-value="'btn-primary'"/>
		        <t t-else="" t-set="_btn_type" t-value="'btn-secondary'"/>
		        <button t-if="displayDoneButton" t-attf-class="btn #{_btn_type}"
		                t-on-click="onClickValidateButton" t-att-barcode_trigger="props.barcodeTarget ? 'CLMO' : false">
		            <t t-if="state.underValidation">Undo</t>
		            <t t-elif="trackingMode === 'mass_produce'">Mass Produce</t>
		            <t t-else="">Close Production</t>
		        </button>
	        </t>
		</xpath>
	</t>


	<t t-inherit="mrp_workorder.MrpDisplayWorkorderFooter" t-inherit-mode="extension">
		<xpath expr="//button[@t-if='displayDoneButton']" position="replace">
			<t t-if="record.type == 'parallel'">
				<span></span>
			</t>
			<t t-else="">
				<t t-if="displayDoneButton">
					<button t-attf-class="btn #{_btn_type}"
			                t-on-click="onClickValidateButton" t-att-barcode_trigger="props.barcodeTarget ? 'CLWO' : false">
			            <t t-if="state.underValidation">Undo</t>
			            <t t-else="">Mark as Done</t>
			        </button>
			    </t>
			</t>
		</xpath>
		<!-- <xpath expr="//button[@t-if='displayCloseProductionButton']" position="replace">
			<t t-if="record.type == 'parallel'">
				<span>Please close Production in backend.</span>
			</t>
			<t t-else="">
				<button t-if="displayCloseProductionButton" class="btn btn-primary flex-grow-1 ms-5"
                barcode_trigger="CLMO" t-on-click="onClickCloseProduction">
           		 Close Production
      			</button>
			</t>
		</xpath>
		<xpath expr="//button[@t-elif='state.underValidation']" position="replace">
			<t t-if="record.type == 'parallel'">
				<span></span>
			</t>
			<t t-else="">
				<button t-elif="state.underValidation" class="me-4" t-attf-class="btn #{_btn_type}" t-on-click="nextOperation">Next Operation</button>
			</t>
		</xpath> -->

		<xpath expr="//button[@t-if='displayCloseProductionButton']" position="replace">
			<t t-if="record.type == 'parallel'">
				<span>Please close Production in backend.</span>
			</t>
			<t t-else="">
			    <t t-if="displayCloseProductionButton">
			        <button class="btn btn-primary flex-grow-1 ms-5"
			                barcode_trigger="CLMO"
			                t-on-click="onClickCloseProduction">
			            Close Production
			        </button>
			    </t>
			    <t t-elif="state.underValidation">
			        <button class="me-4 btn #{_btn_type}"
			                t-on-click="nextOperation">
			            Next Operation
			        </button>
			    </t>
			</t>

		</xpath>





    </t>

</templates>