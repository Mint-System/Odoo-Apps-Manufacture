<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="view_mrp_workorder_tree_inherit_register" model="ir.ui.view">
        <field name="name">mrp.workorder.tree.inherit.register</field>
        <field name="model">mrp.workorder</field>
        <field
            name="inherit_id"
            ref="mrp.mrp_production_workorder_tree_editable_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <!-- <button name="action_register_serial_test"
                        type="object"
                        string="Register"
                        icon="fa-barcode"
                        invisible="type != 'sequential' or state == 'done'"/>
                <field name="registered" widget="boolean_toggle"/> -->
                <field name="id" />
                <field name="parallel_workorder_id" readonly="1" />
                <field name="is_repair_wo" readonly="1" />
                <field name="repair_order_id" readonly="1" />
                <field name="date_start" />
                <field name="date_finished" />
            </xpath>
        </field>
    </record>
    <record id="view_mrp_production_form_inherit_parallel" model="ir.ui.view">
        <field name="name">mrp.production.form.parallel.workorders</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']" position="attributes">
                <attribute name="invisible">type == 'parallel'</attribute>
            </xpath>
            <xpath expr="//page[@name='operations']" position="after">
                <page
                    name="parallel_workorders"
                    string="Parallel Work Orders"
                    invisible="type != 'parallel'"
                >
                    <field
                        name="workorder_ids"
                        domain="[('type','=','parallel')]"
                        context="{'default_type':'parallel'}"
                    >
                        <list>
                            <field
                                name="type"
                                widget="badge"
                                invisible="type != 'parallel'"
                            />
                            <field name="name" />
                            <field name="id" />
                            <field name="workcenter_id" />
                            <field name="is_repair_wo" readonly="1" />
                            <!-- <field name="sequential_serials_in_step"/> -->
                            <!--   <field name="registered_serials_info"
                               string="Registered Serials"
                               invisible="type != 'parallel'"/> -->
                            <field name="duration_expected" widget="float_time"/>
                            <field name="duration" widget="float_time" />
                            <field name="date_start" />
                            <field name="date_finished" />
                            <field name="state" />
                            <button
                                name="action_test_bus_simple"
                                type="object"
                                string="TEST BUS"
                                icon="fa-arrow"
                            />
                            <button
                                name="action_finish_batch"
                                type="object"
                                string="BATCH FINISH"
                                icon="fa-check"
                            />
                            <button
                                name="action_handle_parallel_start"
                                type="object"
                                string="Start"
                                icon="fa-play"
                                invisible="has_ready == False"
                            />
                            <button
                                name="action_handle_parallel_continue"
                                type="object"
                                string="Continue"
                                icon="fa-play-circle"
                                invisible="has_paused == False"
                            />
                            <button
                                name="action_handle_parallel_stop"
                                type="object"
                                string="Stop"
                                icon="fa-stop"
                                invisible="has_running == False"
                            />
                            <button
                                name="action_handle_parallel_finish"
                                type="object"
                                string="Finish"
                                icon="fa-check"
                                invisible="has_running == False"
                            />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record
        id="view_mrp_production_search_inherit_exclude_sequential"
        model="ir.ui.view"
    >
        <field name="name">mrp.production.search.inherit.exclude.sequential</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='todo']" position="after">
                <filter
                    name="todo_non_sequential"
                    string="To-Do (no Sequential)"
                    domain="[('state', 'in', ('draft', 'confirmed', 'progress', 'to_close')), ('type', '!=', 'sequential')]"
                />
            </xpath>
        </field>
    </record>

    <!--

<record id="mrp_production_action" model="ir.actions.act_window">
    <field name="context" eval="{'search_default_todo_non_sequential': True}"/>
</record> -->
</odoo>
